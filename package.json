{
  "name": "kubelab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web --",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web --",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "vitest": "^3.2.0",
    "typescript": "~5.9.3",
    "@types/node": "^22.0.0"
  },
  "packageManager": "npm@11.6.2"
}
