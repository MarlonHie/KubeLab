{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KubeLab Lesson v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "moduleId": {
      "enum": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09",
        "10",
        "11",
        "12",
        "13",
        "14",
        "15",
        "16"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": ["Fundamentals", "Deep Dive", "Expert"]
    },
    "duration": {
      "type": "integer",
      "minimum": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "navLabel": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "text"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "heading"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "text"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "list"
                    },
                    "ordered": {
                      "type": "boolean"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": ["type", "ordered", "items"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "code"
                    },
                    "language": {
                      "enum": ["bash", "yaml", "json", "text"]
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "execution": {
                      "enum": ["external", "simulation", "example", "output"]
                    },
                    "caption": {
                      "type": "string",
                      "minLength": 1
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "language",
                    "code",
                    "execution",
                    "caption"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "table"
                    },
                    "caption": {
                      "type": "string",
                      "minLength": 1
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": ["type", "caption", "headers", "rows"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "callout"
                    },
                    "tone": {
                      "enum": ["note", "warning", "tip"]
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["type", "tone", "title", "text"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "experiment"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "kind": {
                      "enum": [
                        "architecture",
                        "api",
                        "quorum",
                        "reconciliation",
                        "scheduler",
                        "runtime",
                        "flow",
                        "failure",
                        "raft-internals",
                        "scheduler-internals"
                      ]
                    }
                  },
                  "required": ["type", "id", "kind"]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "task"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hint": {
                      "type": "string",
                      "minLength": 1
                    },
                    "solution": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verification": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "reflection"
                            }
                          },
                          "required": ["kind"]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "matching"
                            },
                            "instruction": {
                              "type": "string",
                              "minLength": 1
                            },
                            "options": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 2,
                              "uniqueItems": true
                            },
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "prompt": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "answer": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": ["prompt", "answer"]
                              },
                              "minItems": 1
                            }
                          },
                          "required": [
                            "kind",
                            "instruction",
                            "options",
                            "items"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "experiment"
                            },
                            "experimentId": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]*$"
                            },
                            "requirements": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "event": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "label": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": ["event", "label"]
                              },
                              "minItems": 1
                            }
                          },
                          "required": ["kind", "experimentId", "requirements"]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "state-machine"
                            },
                            "experimentId": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]*$"
                            },
                            "challengeId": {
                              "enum": [
                                "raft-partition-v1",
                                "scheduler-pipeline-v1"
                              ]
                            }
                          },
                          "required": ["kind", "experimentId", "challengeId"]
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "title",
                    "prompt",
                    "hint",
                    "solution",
                    "verification"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "quiz"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "questions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]*$"
                          },
                          "prompt": {
                            "type": "string",
                            "minLength": 1
                          },
                          "answers": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "minItems": 2,
                            "uniqueItems": true
                          },
                          "correct": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "explanation": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "id",
                          "prompt",
                          "answers",
                          "correct",
                          "explanation"
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": ["type", "id", "title", "questions"]
                }
              ]
            },
            "minItems": 1
          },
          "collapsible": {
            "type": "boolean"
          }
        },
        "required": ["id", "title", "navLabel", "blocks"]
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        },
        "required": ["title", "url"]
      },
      "minItems": 1
    },
    "reviewedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "moduleId",
    "title",
    "description",
    "category",
    "level",
    "duration",
    "goals",
    "sections",
    "sources",
    "reviewedOn"
  ]
}
